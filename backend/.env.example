DATABASE_URL=sqlite:///./linguameet.db
STORAGE_ROOT=../storage

# Speech-to-text: set STT_PROVIDER to "deepgram" or "faster_whisper"
STT_PROVIDER=faster_whisper
DEEPGRAM_API_KEY=
WHISPER_MODEL_SIZE=base
WHISPER_MODEL_DIR=models/whisper

# Translation: set TRANSLATION_PROVIDER to "google" or "nllb"
TRANSLATION_PROVIDER=nllb
GOOGLE_TRANSLATE_API_KEY=
NLLB_MODEL_DIR=models/nllb-200-distilled-600M-ct2-int8

# --- WebRTC ICE / TURN ---
# Direct/STUN works on open networks; restrictive NATs/firewalls need a TURN relay.
# TURN_URLS='["turn:turn.example.com:3478?transport=udp","turn:turn.example.com:3478?transport=tcp","turns:turn.example.com:5349?transport=tcp"]'
# Either static credentials:
# TURN_USERNAME=user
# TURN_CREDENTIAL=pass
# or coturn static-auth-secret (short-lived per-user credentials are minted automatically):
# TURN_SECRET=your-coturn-static-auth-secret
# TURN_CREDENTIAL_TTL_SECONDS=3600
