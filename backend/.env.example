# MySQL — fill in real credentials only in .env, never here. Tables are
# created automatically on backend startup if they don't already exist.
DB_DIALECT=mysql+pymysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=nymeet
DB_USERNAME=
DB_PASSWORD=
STORAGE_ROOT=../storage

# Translation: set TRANSLATION_PROVIDER to "google" or "nllb"
TRANSLATION_PROVIDER=nllb
GOOGLE_TRANSLATE_API_KEY=
NLLB_MODEL_DIR=models/nllb-200-distilled-600M-ct2-int8

# --- AWS (Chime SDK Meetings + Media Pipelines + S3 recordings + Transcribe Streaming) ---
# Credentials: use the standard AWS env vars / instance role — do not put keys in this file.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=

# Control-plane region for chime-sdk-meetings / chime-sdk-media-pipelines (must be a Chime control region, e.g. us-east-1)
AWS_CHIME_CONTROL_REGION=us-east-1

# Media region where call audio/video/recording actually run
AWS_CHIME_MEDIA_REGION=us-east-1

# S3 bucket composited recordings are written to
AWS_RECORDINGS_BUCKET=

# Optional, only if the bucket uses a customer-managed KMS key
# AWS_RECORDINGS_KMS_KEY_ID=
# AWS_CHIME_SINK_IAM_ROLE_ARN=

# Region for Amazon Transcribe Streaming (live captions) — avoid af-south-1,
# ap-northeast-1, ap-southeast-5, ap-southeast-7, cn-northwest-1 (no Gujarati streaming there)
AWS_TRANSCRIBE_REGION=us-east-1
